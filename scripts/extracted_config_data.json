  "addcfg": {
    "type": "addcfg",
    "raw": "<form id=\"add-form\" class=\"form-horizontal\" role=\"form\" data-toggle=\"validator\" method=\"POST\" action=\"/coinht.php/general.config/add\">\n                    <div class=\"form-group\">\n                        <label for=\"type\" class=\"control-label col-xs-12 col-sm-2\">Type:</label>\n                        <div class=\"col-xs-12 col-sm-4\">\n                            <select name=\"row[type]\" class=\"form-control selectpicker\">\n                                                                <option value=\"string\" selected>String</option>\n                                                                <option value=\"text\" >Text</option>\n                                                                <option value=\"editor\" >Editor</option>\n                                                                <option value=\"number\" >Number</option>\n                                                                <option value=\"date\" >Date</option>\n                                                                <option value=\"time\" >Time</option>\n                                                                <option value=\"datetime\" >Datetime</option>\n                                                                <option value=\"select\" >Select</option>\n                                                                <option value=\"selects\" >Selects</option>\n                                                                <option value=\"image\" >Image</option>\n                                                                <option value=\"images\" >Images</option>\n                                                                <option value=\"file\" >File</option>\n                                                                <option value=\"files\" >Files</option>\n                                                                <option value=\"switch\" >Switch</option>\n                                                                <option value=\"checkbox\" >Checkbox</option>\n                                                                <option value=\"radio\" >Radio</option>\n                                                                <option value=\"array\" >Array</option>\n                                                                <option value=\"custom\" >Custom</option>\n                                                            </select>\n                        </div>\n                    </div>\n                    <div class=\"form-group\">\n                        <label for=\"group\" class=\"control-label col-xs-12 col-sm-2\">Group:</label>\n                        <div class=\"col-xs-12 col-sm-4\">\n                            <select name=\"row[group]\" class=\"form-control selectpicker\">\n                                                                <option value=\"basic\" selected>Basic</option>\n                                                                <option value=\"recharge\" >充值设置</option>\n                                                                <option value=\"cashout\" >提现设置</option>\n                                                                <option value=\"stock\" >行情配置</option>\n                                                                <option value=\"message\" >消息配置</option>\n                                                                <option value=\"azure\" >Azure存储配置</option>\n                                                                <option value=\"other\" >其他设置</option>\n                                                            </select>\n                        </div>\n                    </div>\n                    <div class=\"form-group\">\n                        <label for=\"name\" class=\"control-label col-xs-12 col-sm-2\">Name:</label>\n                        <div class=\"col-xs-12 col-sm-4\">\n                            <input type=\"text\" class=\"form-control\" id=\"name\" name=\"row[name]\" value=\"\" data-rule=\"required; length(3~30); remote(general/config/check)\" />\n                        </div>\n                    </div>\n                    <div class=\"form-group\">\n                        <label for=\"title\" class=\"control-label col-xs-12 col-sm-2\">Title:</label>\n                        <div class=\"col-xs-12 col-sm-4\">\n                            <input type=\"text\" class=\"form-control\" id=\"title\" name=\"row[title]\" value=\"\" data-rule=\"required\" />\n                        </div>\n                    </div>\n                    <div class=\"form-group\">\n                        <label for=\"value\" class=\"control-label col-xs-12 col-sm-2\">Value:</label>\n                        <div class=\"col-xs-12 col-sm-4\">\n                            <input type=\"text\" class=\"form-control\" id=\"value\" name=\"row[value]\" value=\"\" data-rule=\"\" />\n                        </div>\n                    </div>\n                    <div class=\"form-group hide\" id=\"add-content-container\">\n                        <label for=\"content\" class=\"control-label col-xs-12 col-sm-2\">Content:</label>\n                        <div class=\"col-xs-12 col-sm-4\">\n                            <textarea name=\"row[content]\" id=\"content\" cols=\"30\" rows=\"5\" class=\"form-control\" data-rule=\"required\">value1|title1\nvalue2|title2</textarea>\n                        </div>\n                    </div>\n                    <div class=\"form-group\">\n                        <label for=\"tip\" class=\"control-label col-xs-12 col-sm-2\">Tip:</label>\n                        <div class=\"col-xs-12 col-sm-4\">\n                            <input type=\"text\" class=\"form-control\" id=\"tip\" name=\"row[tip]\" value=\"\" data-rule=\"\" />\n                        </div>\n                    </div>\n                    <div class=\"form-group\">\n                        <label for=\"rule\" class=\"control-label col-xs-12 col-sm-2\">Rule:</label>\n                        <div class=\"col-xs-12 col-sm-4\">\n                            <input type=\"text\" class=\"form-control\" id=\"rule\" name=\"row[rule]\" value=\"\" />\n                        </div>\n                    </div>\n                    <div class=\"form-group\">\n                        <label for=\"extend\" class=\"control-label col-xs-12 col-sm-2\">Extend:</label>\n                        <div class=\"col-xs-12 col-sm-4\">\n                            <textarea name=\"row[extend]\" id=\"extend\" cols=\"30\" rows=\"5\" class=\"form-control\" data-rule=\"\"></textarea>\n                        </div>\n                    </div>\n                    <div class=\"form-group\">\n                        <label class=\"control-label col-xs-12 col-sm-2\"></label>\n                        <div class=\"col-xs-12 col-sm-4\">\n                            <button type=\"submit\" class=\"btn btn-success btn-embossed\">OK</button>\n                            <button type=\"reset\" class=\"btn btn-default btn-embossed\">Reset</button>\n                        </div>\n                    </div>\n\n                </form>"
  }
